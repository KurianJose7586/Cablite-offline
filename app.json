      },
      "edgeToEdgeEnabled": true,
      "package": "com.kurianjose7586.CabliteTest"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fdf01cc0-6475-497e-bd88-1cf4e2e1e5f2"
      }
    }
  }
}
